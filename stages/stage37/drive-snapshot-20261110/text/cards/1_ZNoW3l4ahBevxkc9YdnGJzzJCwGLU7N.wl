Clear[a,b,x,m,n]; nn=a^2+b^2; dd=2b^2-25a^2; tt=a^2+2b^2; f=nn*x^4-8*a*b*x^3+(11*a^2-b^2)*x^2+6*a*b*x-a^2; g=Expand[nn^3*(f/.x->x/nn)]; fh=Expand[n^4*(f/.x->m/n)]; {g, Factor[Discriminant[f,x]], Factor[Discriminant[g,x]], Factor[Resultant[g,nn*m-n*x,x]], Factor[Resultant[g,x*(a*nn-b*x),x]], Factor[f/.x->a/b], Simplify[{Discriminant[f,x]==16*a^2*nn^2*dd^3,Discriminant[g,x]==16*a^2*nn^8*dd^3,Resultant[g,nn*m-n*x,x]==nn^3*fh,Resultant[g,x*(a*nn-b*x),x]==-a^4*nn^6*tt^2}]}
