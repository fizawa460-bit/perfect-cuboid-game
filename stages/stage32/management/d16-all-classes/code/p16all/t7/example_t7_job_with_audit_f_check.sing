LIB "primdec.lib"; LIB "elim.lib"; LIB "normal.lib";
ring R = 10009,(a1,a2,a3,b1,b2,b3,c),dp; number z = 792;
ideal S = a1^2+a2^2-b3^2, a2^2+a3^2-b1^2, a1^2+a3^2-b2^2, a1^2+a2^2+a3^2-c^2;
proc satur(ideal I, ideal Q) { def T = sat(I, Q); ideal R2; if (typeof(T) == "list") { R2 = T[1]; } else { R2 = T; } return(std(R2)); }
ideal MX = maxideal(1);
ideal G20 = satur(std(S + ideal(a3,a1+(1)*b2,a2+(-1)*b1,b3+(-1)*c)), MX);
ideal G24 = satur(std(S + ideal(a3,a1+(-1)*b2,a2+(-1)*b1,b3+(-1)*c)), MX);
ideal G55 = satur(std(S + ideal(a2+(1)*a3,(z-z^3)*a2+(-1)*b1,b2+(1)*b3)), MX);
ideal G83 = satur(std(S + ideal((z^2)*a2+(1)*c,(z^2)*b3+(-1)*b1,(z^2)*(z-z^3)*a2+(-1)*b2)), MX);
ideal G86 = satur(std(S + ideal((z^2)*a3+(-1)*c,(z^2)*b1+(1)*b2,(z^2)*(z-z^3)*a3+(1)*b3)), MX);
ideal N93 = satur(std(S + ideal(b3,b2+c,b1+c,a3+c,a2,a1)^1), MX);
ideal N101 = satur(std(S + ideal(b3+c,b2,b1+c,a3,a2+c,a1)^1), MX);
ideal N102 = satur(std(S + ideal(b3-c,b2,b1+c,a3,a2+c,a1)^1), MX);
ideal N108 = satur(std(S + ideal(b3-c,b2,b1-c,a3,a2-c,a1)^2), MX);
ideal N110 = satur(std(S + ideal(b3-c,b2+c,b1,a3,a2,a1+c)^1), MX);
ideal N111 = satur(std(S + ideal(b3+c,b2-c,b1,a3,a2,a1+c)^1), MX);
ideal N112 = satur(std(S + ideal(b3-c,b2-c,b1,a3,a2,a1+c)^1), MX);
ideal N114 = satur(std(S + ideal(b3-c,b2+c,b1,a3,a2,a1-c)^1), MX);
ideal N115 = satur(std(S + ideal(b3+c,b2-c,b1,a3,a2,a1-c)^1), MX);
ideal N116 = satur(std(S + ideal(b3-c,b2-c,b1,a3,a2,a1-c)^1), MX);
ideal N126 = satur(std(S + ideal(c,b2,b1+(-z^2)*b3,a3+b1,a2,a1+b3)^1), MX);
ideal N128 = satur(std(S + ideal(c,b2,b1+(-z^2)*b3,a3-b1,a2,a1+b3)^1), MX);
ideal N130 = satur(std(S + ideal(c,b2,b1+(-z^2)*b3,a3+b1,a2,a1-b3)^1), MX);
ideal N132 = satur(std(S + ideal(c,b2,b1+(-z^2)*b3,a3-b1,a2,a1-b3)^1), MX);
ideal N133 = satur(std(S + ideal(c,b3,b1+(z^2)*b2,a3,a2-b1,a1+b2)^1), MX);
ideal N134 = satur(std(S + ideal(c,b3,b1+(-z^2)*b2,a3,a2+b1,a1+b2)^1), MX);
ideal N136 = satur(std(S + ideal(c,b3,b1+(-z^2)*b2,a3,a2-b1,a1+b2)^1), MX);
ideal N137 = satur(std(S + ideal(c,b3,b1+(z^2)*b2,a3,a2-b1,a1-b2)^1), MX);
ideal N138 = satur(std(S + ideal(c,b3,b1+(-z^2)*b2,a3,a2+b1,a1-b2)^1), MX);
ideal N140 = satur(std(S + ideal(c,b3,b1+(-z^2)*b2,a3,a2-b1,a1-b2)^1), MX);
ideal Iall = intersect(G20,G24,G55,G83,G86,N93,N101,N102,N108,N110,N111,N112,N114,N115,N116,N126,N128,N130,N132,N133,N134,N136,N137,N138,N140); Iall = std(Iall);
int mm = 2; int q; int r; int t;
ideal Lsys; t = 0;
for (q = 1; q <= ncols(Iall); q++) { if (Iall[q] != 0) { if (deg(Iall[q]) <= mm) { if (deg(Iall[q]) == mm) { t++; Lsys[t] = Iall[q]; } else { ideal U = maxideal(mm - deg(Iall[q])); for (r = 1; r <= ncols(U); r++) { t++; Lsys[t] = U[r] * Iall[q]; } kill U; } } } }
ideal SS = std(S); "H0 (h0):", size(kbase(SS, mm)) - size(kbase(Iall, mm));
ideal SS = std(S);
ideal NFL = simplify(reduce(Lsys, SS), 2);
poly F0 = NFL[1]; poly F1 = 0; int q2;
for (q2 = 2; q2 <= ncols(NFL); q2++) { if (rank(coeffs(ideal(F0, NFL[q2]), maxideal(mm))) == 2) { F1 = NFL[q2]; break; } }
"pencil degree", deg(F0), deg(F1);
system("random", 2718); poly PB0 = F0 + random(1,9999)*F1; poly PB1 = F1 + random(1,9999)*F0; F0 = PB0; F1 = PB1; kill PB0; kill PB1;
ideal Dc = std(intersect(G20,G24,G55,G83,G86));
poly NN = F0 - (9180) * F1;
int HH = 2; list FL; FL[1] = F0; FL[2] = F1; int kk; int js; string TAG = "sx_1059_0";
ideal NODES = std(S + minor(jacob(S), 4));
list DL; intvec DLc;
DL[1] = G20; DLc[1] = 1;
DL[2] = G24; DLc[2] = 1;
DL[3] = G55; DLc[3] = 1;
DL[4] = G83; DLc[4] = 1;
DL[5] = G86; DLc[5] = 1;
proc ordP(poly F, ideal P) { int k = 0; int mm2; for (mm2 = 1; mm2 <= 6; mm2++) { if (size(reduce(F, satur(std(S + P^mm2), MX))) == 0) { k = mm2; } else { break; } } return(k); }
LIB "primdec.lib"; LIB "normal.lib";
// audit (f): the generic member FL[1] = F0 must not be special along the D-curves, and NN must differ from F0
ideal BBc1 = std(S + ideal(F0 + 7*F1)); ideal BBc0 = std(S + ideal(F0)); int jc; int okc = 1;
for (jc = 1; jc <= size(DLc); jc++) { int e1 = (mult(BBc1) - mult(satur(BBc1, DL[jc]))) div mult(DL[jc]); int e0 = (mult(BBc0) - mult(satur(BBc0, DL[jc]))) div mult(DL[jc]); if (e1 != DLc[jc] || e0 != DLc[jc]) { okc = 0; "EXG-MISMATCH", jc, e0, e1, DLc[jc]; } kill e1; kill e0; }
if (size(reduce(ideal(NN), std(ideal(F0)))) == 0) { okc = 0; "NN-EQUALS-F0"; }
if (okc) { "EXG-CHECK OK"; } else { "EXG-CHECK BAD"; }
kill BBc1; kill BBc0; kill jc; kill okc;
// direction basis: for HH = 2: B = an FL independent of NN; for HH >= 3: FL2, FL3 (generic) with NN
int b1 = 1; if (rank(coeffs(ideal(NN, FL[1]), maxideal(mm))) < 2) { b1 = 2; }
proc baddir(ideal J2, poly F2, poly F3, poly FN, int hh) { if (hh == 2) { if (reduce(F2, J2) == 0) { return("B"); } return("NONE"); }
  poly r2 = reduce(F2, J2); poly r3 = reduce(F3, J2); poly rn = reduce(FN, J2); string sout;
  if (rn != 0) { sout = "NNOUT"; } else { if (r2 == 0 && r3 == 0) { sout = "ALL"; } else { if (r3 == 0) { sout = "t0"; } else { if (r2 == 0) { sout = "tinf"; } else {
    number kq = leadcoef(r2) / leadcoef(r3); if (r2 - kq * r3 == 0) { sout = "t" + string(kq); } else { sout = "NONE"; } } } } }
  return(sout); }
poly P2 = FL[b1]; poly P3 = 0; if (HH >= 3) { P2 = FL[2]; P3 = FL[3]; }
proc dmul(ideal Q) { int k; for (k = 1; k <= size(DLc); k++) { if (size(reduce(DL[k], Q)) == 0 && size(reduce(Q, std(DL[k]))) == 0) { return(DLc[k]); } } return(0); }
proc gpow(ideal G, int c) { if (c == 0) { return(ideal(1)); } return(satur(satur(std(S + G^c), NODES), MX)); }
ideal B = std(S + ideal(NN)); ideal Bp = satur(B, Dc); list QL; intvec QM; intvec DM; int nq = 0; int ia; int ib; int ic; int jj;
if (dim(Bp) == 2) { list MA = minAssGTZ(Bp); for (ia = 1; ia <= size(MA); ia++) { ideal QA = std(MA[ia]); if (dim(QA) == 2) { nq++; QL[nq] = QA; ideal RZq = satur(Bp, QA); QM[nq] = (mult(Bp) - mult(RZq)) div mult(QA); DM[nq] = 0; kill RZq; } kill QA; } }
ideal BBg2 = std(S + ideal(FL[1]));
for (js = 1; js <= size(DLc); js++) { int exn = (mult(B) - mult(satur(B, DL[js]))) div mult(DL[js]); int exg = (mult(BBg2) - mult(satur(BBg2, DL[js]))) div mult(DL[js]); if (exn > exg) { nq++; QL[nq] = std(DL[js]); QM[nq] = exn - exg; DM[nq] = exg; } kill exn; kill exg; }
"COMPS", nq; int sg = 0; for (ia = 1; ia <= nq; ia++) { int gq = genus(QL[ia]); "COMP", ia, mult(QL[ia]), QM[ia], gq; if (gq > 0) { sg = sg + gq; } kill gq; }
"SIGMAG", sg;
for (ia = 1; ia <= nq; ia++) { "BADC", ia, baddir(gpow(QL[ia], DM[ia] + 1), P2, P3, NN, HH); }
for (ia = 1; ia < nq; ia++) { for (ib = ia + 1; ib <= nq; ib++) { ideal W = satur(std(QL[ia] + QL[ib]), NODES);
  if (dim(W) > 0) { list PW = minAssGTZ(W); int kq2; for (kq2 = 1; kq2 <= size(PW); kq2++) { ideal PP = std(PW[kq2]);
      int lw = mult(std(QL[ia] + QL[ib] + PP^4)) div mult(PP); string on = ""; for (ic = 1; ic <= nq; ic++) { if (size(reduce(QL[ic], PP)) == 0) { on = on + " " + string(ic); } }
      ideal JQ = satur(satur(std(S + gpow(QL[ia], DM[ia]) * gpow(QL[ib], DM[ib]) * PP), NODES), MX);
      int bp = 1; for (kk = 1; kk <= HH; kk++) { if (reduce(FL[kk], JQ) != 0) { bp = 0; } }
      "CROSS", ia, ib, " pdeg", mult(PP), " len", lw, " on", on, " basept", bp;
      if (bp) { ideal Ja = satur(satur(std(S + gpow(QL[ia], DM[ia] + 1) + gpow(QL[ia], DM[ia]) * gpow(QL[ib], DM[ib]) * PP^2), NODES), MX);
        ideal Jb = satur(satur(std(S + gpow(QL[ib], DM[ib] + 1) + gpow(QL[ia], DM[ia]) * gpow(QL[ib], DM[ib]) * PP^2), NODES), MX);
        "BADX", ia, ib, kq2, " base", baddir(Ja, P2, P3, NN, HH), baddir(Jb, P2, P3, NN, HH); kill Ja; kill Jb; } else { "BADX", ia, ib, kq2, " pt", baddir(JQ, P2, P3, NN, HH); }
      kill PP; kill lw; kill on; kill JQ; kill bp; } kill PW; kill kq2; }
  kill W; } }
list NPL = minAssGTZ(NODES);
for (jj = 1; jj <= size(NPL); jj++) { ideal NP = std(NPL[jj]);
  int oN = ordP(NN, NP); int oG = 99; for (kk = 1; kk <= HH; kk++) { int o3 = ordP(FL[kk], NP); if (o3 < oG) { oG = o3; } kill o3; } int e = oN - oG; string th = ""; intvec thr; int nt = 0; int lok = 1;
  for (ia = 1; ia <= nq; ia++) { if (size(reduce(QL[ia], NP)) == 0) { nt++; thr[nt] = ia; th = th + " " + string(ia); } }
  for (ia = 1; ia < nt; ia++) { for (ib = ia + 1; ib <= nt; ib++) { ideal W = std(QL[thr[ia]] + QL[thr[ib]]); ideal Wo = satur(W, NP); int ll = mult(W) - mult(Wo); if (dim(Wo) <= 0) { ll = mult(W); } if (ll != 1) { lok = 0; } kill W; kill Wo; kill ll; } }
  if (nt > 0 || e > 0) { "NODE", jj, mult(NP), e, lok, " comps", th; }
  if (e > 0) { "BADE", jj, baddir(satur(std(S + NP^(oG + 1)), MX), P2, P3, NN, HH); }
  kill NP; kill oN; kill oG; kill e; kill th; kill thr; kill nt; kill lok; }
"HH", HH; "END";
quit;
