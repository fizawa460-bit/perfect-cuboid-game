ring R = (0,I),(u0,u1,u2,u3,u4,u5,u6),dp;
minpoly = I^2+1;
ideal T =
-4*u0*u6 + u2^2 - 4*u3*u6 - 8*u4*u6,
-4*u0*u6 + u2^2,
-4*u4*u6 + u5^2,
4*u3*u6 + 4*u4*u6 + u5^2,
4*u0*u3 + 4*u0*u4 + 4*u0*u5 - 4*u0*u6 + u1^2 - 2*u1*u2 - 2*u1*u3 - 4*u1*u4 - 2*u1*u5 + 4*u1*u6 + u2^2 - 2*u2*u3 - 2*u2*u5 + u3^2 + 4*u3*u4 + 2*u3*u5 + 4*u4^2 + 4*u4*u5 - 4*u4*u6 + u5^2,
-4*u0*u4 - 4*u0*u5 - 4*u0*u6 + u1^2 + 2*u1*u2 + 2*u1*u3 + 4*u1*u4 + 2*u1*u5 + 4*u1*u6 + u2^2 + 2*u2*u3 - 2*u2*u5 + u3^2 - 2*u3*u5 - 4*u4^2 - 4*u4*u5 - 4*u4*u6 + u5^2,
4*u0*u3 + 4*u0*u4 - 4*u0*u5 - 4*u0*u6 + u1^2 + 2*u1*u2 - 2*u1*u3 - 4*u1*u4 + 2*u1*u5 + 4*u1*u6 + u2^2 + 2*u2*u3 - 2*u2*u5 + u3^2 + 4*u3*u4 - 2*u3*u5 + 4*u4^2 - 4*u4*u5 - 4*u4*u6 + u5^2,
-4*u0*u4 + 4*u0*u5 - 4*u0*u6 + u1^2 - 2*u1*u2 + 2*u1*u3 + 4*u1*u4 - 2*u1*u5 + 4*u1*u6 + u2^2 - 2*u2*u3 - 2*u2*u5 + u3^2 + 2*u3*u5 - 4*u4^2 + 4*u4*u5 - 4*u4*u6 + u5^2,
-4*u0*u3 - 4*u0*u4 - 4*I*u0*u5 - 4*u0*u6 - u1^2 + 2*I*u1*u2 - 2*u1*u3 - 4*u1*u4 - 2*I*u1*u5 - 4*u1*u6 + u2^2 - 2*I*u2*u3 + 2*u2*u5 - u3^2 - 4*u3*u4 - 2*I*u3*u5 - 4*u4^2 - 4*I*u4*u5 - 4*u4*u6 + u5^2,
4*u0*u4 + 4*I*u0*u5 - 4*u0*u6 - u1^2 - 2*I*u1*u2 + 2*u1*u3 + 4*u1*u4 + 2*I*u1*u5 - 4*u1*u6 + u2^2 + 2*I*u2*u3 + 2*u2*u5 - u3^2 + 2*I*u3*u5 + 4*u4^2 + 4*I*u4*u5 - 4*u4*u6 + u5^2,
-4*u0*u3 - 4*u0*u4 + 4*I*u0*u5 - 4*u0*u6 - u1^2 - 2*I*u1*u2 - 2*u1*u3 - 4*u1*u4 + 2*I*u1*u5 - 4*u1*u6 + u2^2 + 2*I*u2*u3 + 2*u2*u5 - u3^2 - 4*u3*u4 + 2*I*u3*u5 - 4*u4^2 + 4*I*u4*u5 - 4*u4*u6 + u5^2,
4*u0*u4 - 4*I*u0*u5 - 4*u0*u6 - u1^2 + 2*I*u1*u2 + 2*u1*u3 + 4*u1*u4 - 2*I*u1*u5 - 4*u1*u6 + u2^2 - 2*I*u2*u3 + 2*u2*u5 - u3^2 - 2*I*u3*u5 + 4*u4^2 - 4*I*u4*u5 - 4*u4*u6 + u5^2;
// F as a polynomial in the u's, coefficient list in the 25 monomials x0^i x1^(4-i) y0^j y1^(4-j)
matrix FC[25][1];
FC[1,1] = u6;
FC[2,1] = u2;
FC[3,1] = u0 + u3 + 2*u4;
FC[4,1] = 0;
FC[5,1] = 0;
FC[6,1] = -u2;
FC[7,1] = -2*u0 - u3 - 2*u4;
FC[8,1] = u5;
FC[9,1] = u1;
FC[10,1] = 0;
FC[11,1] = u0;
FC[12,1] = -u5;
FC[13,1] = -2*u1 - 2*u6;
FC[14,1] = -u2;
FC[15,1] = -u3 - u4;
FC[16,1] = 0;
FC[17,1] = u1;
FC[18,1] = u2;
FC[19,1] = u3;
FC[20,1] = -u5;
FC[21,1] = 0;
FC[22,1] = 0;
FC[23,1] = u4;
FC[24,1] = u5;
FC[25,1] = u6;
