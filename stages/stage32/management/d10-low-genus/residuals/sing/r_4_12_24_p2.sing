LIB "elim.lib"; LIB "normal.lib"; LIB "absfact.lib";
ring R = 0,(b,c,d,e,f,g,u,v,w),dp;
ideal S = -b^2 + d^2,-c^2 + e^2,-b^2 - c^2 + f^2,-b^2 - c^2 + g^2;
ideal C0 = std(S + ideal(-b + d,-c + e,f + g));
ideal C1 = std(S + ideal(-b + d,c + e,f + g));
ideal C2 = std(S + ideal(b + d,c + e,-f + g));
list L = sat(std(S), intersect(C0, intersect(C1, C2))); ideal Res = std(L[1]);
ideal Pr = Res, u - ((-6)*b+(1)*c+(9)*d+(-2)*e+(5)*f+(3)*g), v - ((4)*b+(7)*c+(-3)*d+(1)*e+(-8)*f+(2)*g), w - ((2)*b+(-5)*c+(6)*d+(9)*e+(1)*f+(-7)*g);
ideal E = eliminate(Pr, b*c*d*e*f*g);
int ng = size(E); poly F = subst(E[1], w, 1); int rd = mult(Res); int pd = deg(E[1]);
ring r3 = 0,(u,v),dp; poly F = imap(R, F);
int na; def AF = absFactorize(F); setring AF; na = size(absolute_factors[1]) - 1; setring r3;
int gg = -99; if (na == 1) { gg = genus(ideal(F)); }
"RESULT 4 12 24 proj 2 resdeg", rd, "planegens", ng, "planedeg", pd, "absfactors", na, "genus", gg;
quit;
