LIB "elim.lib"; LIB "normal.lib"; LIB "absfact.lib";
ring R = 0,(a,b,c,d,e,f,u,v,w),dp;
ideal S = -a^2 - b^2 + d^2,-a^2 - c^2 + e^2,-b^2 - c^2 + f^2,-a^2 + 2*b*d - 2*b*f - c^2 + d^2 - 2*d*f + f^2;
ideal C0 = std(S + ideal(c,-a + e,-b + f,-b + f));
ideal C1 = std(S + ideal(c,a + e,-b + f,-b + f));
ideal C2 = std(S + ideal(a,b + d,c + e,-b - d));
list L = sat(std(S), intersect(C0, intersect(C1, C2))); ideal Res = std(L[1]);
ideal Pr = Res, u - ((3)*a+(5)*b+(-7)*c+(2)*d+(11)*e+(-4)*f), v - ((2)*a+(-9)*b+(1)*c+(6)*d+(-3)*e+(8)*f), w - ((1)*a+(1)*b+(4)*c+(-5)*d+(7)*e+(2)*f);
ideal E = eliminate(Pr, a*b*c*d*e*f);
int ng = size(E); poly F = subst(E[1], w, 1); int rd = mult(Res); int pd = deg(E[1]);
ring r3 = 0,(u,v),dp; poly F = imap(R, F);
int na; def AF = absFactorize(F); setring AF; na = size(absolute_factors[1]) - 1; setring r3;
int gg = -99; if (na == 1) { gg = genus(ideal(F)); }
"RESULT 6 22 24 proj 1 resdeg", rd, "planegens", ng, "planedeg", pd, "absfactors", na, "genus", gg;
quit;
