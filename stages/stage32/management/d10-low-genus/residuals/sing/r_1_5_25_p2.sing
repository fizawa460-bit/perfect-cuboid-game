LIB "elim.lib"; LIB "normal.lib"; LIB "absfact.lib";
ring R = 0,(a,c,d,e,f,g,u,v,w),dp;
ideal S = -a^2 + d^2,-a^2 - c^2 + e^2,-c^2 + f^2,-a^2 - c^2 + g^2;
ideal C0 = std(S + ideal(-a + d,-c + f,-e + g));
ideal C1 = std(S + ideal(-a + d,-c + f,e + g));
ideal C2 = std(S + ideal(a + d,c + f,-e + g));
list L = sat(std(S), intersect(C0, intersect(C1, C2))); ideal Res = std(L[1]);
ideal Pr = Res, u - ((-6)*a+(1)*c+(9)*d+(-2)*e+(5)*f+(3)*g), v - ((4)*a+(7)*c+(-3)*d+(1)*e+(-8)*f+(2)*g), w - ((2)*a+(-5)*c+(6)*d+(9)*e+(1)*f+(-7)*g);
ideal E = eliminate(Pr, a*c*d*e*f*g);
int ng = size(E); poly F = subst(E[1], w, 1); int rd = mult(Res); int pd = deg(E[1]);
ring r3 = 0,(u,v),dp; poly F = imap(R, F);
int na; def AF = absFactorize(F); setring AF; na = size(absolute_factors[1]) - 1; setring r3;
int gg = -99; if (na == 1) { gg = genus(ideal(F)); }
"RESULT 1 5 25 proj 2 resdeg", rd, "planegens", ng, "planedeg", pd, "absfactors", na, "genus", gg;
quit;
