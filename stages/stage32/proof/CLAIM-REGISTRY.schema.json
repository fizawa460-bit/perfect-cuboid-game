{
  "$id": "STAGE32_CLAIM_REGISTRY_SCHEMA_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage32 claim registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const":"STAGE32_CLAIM_REGISTRY_V1"},
    "stage": {"const":32},
    "claim_id_contract": {
      "type":"object","additionalProperties":true,
      "properties":{"pattern":{"const":"^S32\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*\\.V[1-9][0-9]*$"},"immutability_rule":{"type":"string"}},
      "required":["pattern","immutability_rule"]
    },
    "authority_status_contract": {
      "type":"object","additionalProperties":true,
      "properties":{"allowed":{"type":"array","uniqueItems":true,"items":{"enum":["SCRATCH","PROVISIONAL","AUDITED","DECLARED_GOAL","SUPERSEDED","REVOKED"]}},"dependency_rules":{"type":"object"}},
      "required":["allowed","dependency_rules"]
    },
    "claims": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":true,
        "properties": {
          "claim_id":{"type":"string","pattern":"^S32\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*\\.V[1-9][0-9]*$"},
          "kind":{"enum":["authority_snapshot","mathematical_claim","lane_contract","adapter_contract"]},
          "statement":{"type":"string","minLength":1},
          "scope_key":{"type":"string","pattern":"^S32\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"},
          "scope":{"type":"object"},
          "proves":{"type":"array","items":{"type":"string"}},
          "does_not_prove":{"type":"array","items":{"type":"string"}},
          "requires":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "claim_core_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "authority_status":{"enum":["SCRATCH","PROVISIONAL","AUDITED","DECLARED_GOAL","SUPERSEDED","REVOKED"]},
          "source_locks":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"path":{"type":"string","minLength":1},"blob_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["path"]}},
          "audit_receipt":{"type":["object","null"]},
          "replay_verifier":{"type":["string","null"]},
          "bridges":{
            "type":"object",
            "properties":{
              "from_scope_key":{"type":"string","pattern":"^S32\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"},
              "to_scope_key":{"type":"string","pattern":"^S32\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)*$"},
              "semantics":{"type":"string"}
            },
            "required":["from_scope_key","to_scope_key"],
            "additionalProperties":true
          },
          "frontier_status":{"type":"string"},
          "blockers":{"type":"array","items":{"type":"string"}},
          "lane_links":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"lane":{"enum":["MAIN","EX1","EX2","EX3","EX4","EX5"]},"role":{"enum":["OWNER","ATTACKS","CONSUMES"]}},"required":["lane","role"]}}
        },
        "required":["claim_id","kind","statement","scope_key","scope","proves","does_not_prove","requires","claim_core_sha256","authority_status","source_locks","audit_receipt"],
        "allOf":[
          {
            "if":{"properties":{"kind":{"const":"adapter_contract"}},"required":["kind"]},
            "then":{"required":["bridges"]}
          }
        ]
      }
    }
  },
  "required":["schema","stage","claim_id_contract","authority_status_contract","claims"]
}
